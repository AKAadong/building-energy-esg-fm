.page {
  padding: 12px 14px 24px;
}

.title {
  display: block;
  font-size: 15px;
  font-weight: 650;
  color: #f1f5f9;
  margin-bottom: 8px;
}

.hint {
  display: block;
  font-size: 12px;
  line-height: 1.65;
  color: #94a3b8;
  margin-bottom: 12px;
}

.hint.warn {
  color: #fcd34d;
}

.primary-mini {
  color: #7dd3fc;
}

.input {
  background: rgba(15, 23, 42, 0.65);
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 8px;
  padding: 12px;
  color: #f8fafc;
  font-size: 14px;
  margin-bottom: 10px;
}

.btn-row {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}

.btn-ghost::after {
  border: none;
}

.save-btn {
  margin-bottom: 8px;
}

.save-btn::after {
  border: none;
}

.test-msg {
  display: block;
  font-size: 12px;
  margin-top: 8px;
}

.test-msg.ok {
  color: #4ade80;
}

.test-msg.err {
  color: #fca5a5;
}

.code {
  display: block;
  font-family: ui-monospace, Consolas, monospace;
  font-size: 11px;
  color: #7dd3fc;
  background: rgba(15, 23, 42, 0.65);
  border-radius: 6px;
  padding: 8px 10px;
  margin-bottom: 6px;
  word-break: break-all;
}
