.page {
  padding: 12px 14px 28px;
}

.top-bar {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
}

.top-title {
  font-size: 16px;
  font-weight: 650;
  color: #f8fafc;
}

.top-meta {
  font-size: 11px;
  color: #64748b;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.api-dot {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 999px;
}

.api-dot.ok {
  color: #4ade80;
  background: rgba(74, 222, 128, 0.12);
}

.api-dot.warn {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.12);
}

.link {
  color: #38bdf8;
  font-size: 13px;
}

.block {
  background: rgba(30, 41, 59, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 12px;
  margin-bottom: 14px;
  padding: 14px;
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}

.block-head .title {
  font-size: 15px;
  font-weight: 650;
  color: #f1f5f9;
}

.block-tag {
  font-size: 10px;
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.15);
  border-radius: 999px;
  padding: 2px 8px;
  flex-shrink: 0;
}

.muted {
  color: #94a3b8;
  font-size: 13px;
  line-height: 1.65;
}

.muted-line {
  color: #94a3b8;
  font-size: 12px;
  line-height: 1.6;
}

.info-line {
  display: block;
  font-size: 12px;
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.08);
  border-radius: 8px;
  padding: 8px 10px;
  margin-bottom: 10px;
  line-height: 1.55;
}

.head-line {
  display: block;
  font-size: 13px;
  color: #cbd5e1;
  margin-bottom: 8px;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 10px;
}

.pill {
  font-size: 11px;
  color: #94a3b8;
  background: rgba(15, 23, 42, 0.55);
  border-radius: 999px;
  padding: 4px 8px;
}

.pill.accent {
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.12);
}

.volume-block {
  margin-bottom: 10px;
}

.volume-line {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  line-height: 1.55;
}

.forecast-scroll {
  max-height: 280px;
}

.asset-card {
  border-top: 1px solid rgba(148, 163, 184, 0.12);
  padding: 10px 0;
}

.asset-head {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 6px;
}

.asset-cat {
  font-size: 11px;
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.12);
  border-radius: 4px;
  padding: 2px 6px;
}

.asset-label {
  flex: 1;
  font-size: 13px;
  color: #f1f5f9;
}

.asset-grid {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 6px;
}

.asset-line {
  display: block;
  font-size: 12px;
  color: #cbd5e1;
  line-height: 1.5;
  margin-bottom: 4px;
}

.asset-line.muted {
  color: #94a3b8;
}

.ops-tag {
  font-size: 10px;
  border-radius: 4px;
  padding: 2px 6px;
}

.ops-tag-success {
  color: #4ade80;
  background: rgba(74, 222, 128, 0.12);
}

.ops-tag-warning {
  color: #fbbf24;
  background: rgba(251, 191, 36, 0.12);
}

.ops-tag-primary {
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.12);
}

.ops-tag-info {
  color: #94a3b8;
  background: rgba(148, 163, 184, 0.12);
}

.ops-tag-danger {
  color: #f87171;
  background: rgba(248, 113, 113, 0.12);
}

.ops-effect {
  display: block;
  font-size: 11px;
  color: #94a3b8;
}

.capture-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 12px;
}

.capture-btn {
  padding: 14px 10px;
  font-size: 14px;
  background: rgba(15, 23, 42, 0.5);
  color: #e2e8f0;
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 10px;
}

.capture-btn.primary {
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.12);
  border-color: rgba(56, 189, 248, 0.45);
}

.capture-btn::after {
  border: none;
}

.preview-img {
  display: block;
  width: 100%;
  border-radius: 10px;
  margin-bottom: 12px;
  background: #020617;
}

.preview-placeholder {
  padding: 24px 16px;
  margin-bottom: 12px;
  border: 1px dashed rgba(148, 163, 184, 0.35);
  border-radius: 10px;
  text-align: center;
}

.run-btn {
  width: 100%;
}

.run-btn::after {
  border: none;
}

.error-line {
  display: block;
  margin-top: 8px;
  color: #fca5a5;
  font-size: 12px;
}

.stat-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 12px;
}

.stat {
  background: rgba(15, 23, 42, 0.55);
  border-radius: 8px;
  padding: 10px;
}

.stat-label {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 4px;
}

.stat-val {
  font-size: 15px;
  font-weight: 600;
  color: #f8fafc;
}

.sub-title {
  display: block;
  font-size: 12px;
  color: #cbd5e1;
  margin-bottom: 8px;
}

.forecast-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.forecast-row {
  display: grid;
  grid-template-columns: 72px 1fr 44px;
  align-items: center;
  gap: 8px;
  font-size: 11px;
}

.forecast-time {
  color: #94a3b8;
}

.forecast-bar-wrap {
  height: 8px;
  background: rgba(15, 23, 42, 0.8);
  border-radius: 4px;
  overflow: hidden;
}

.forecast-bar {
  height: 100%;
  background: linear-gradient(90deg, #0284c7, #38bdf8);
  border-radius: 4px;
  min-width: 4px;
}

.forecast-val {
  text-align: right;
  color: #e2e8f0;
}

.summary-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
}

.summary-chip {
  font-size: 11px;
  color: #bae6fd;
  background: rgba(56, 189, 248, 0.12);
  border-radius: 999px;
  padding: 4px 10px;
}

.summary-chip.warn {
  color: #fcd34d;
  background: rgba(251, 191, 36, 0.12);
}

.asset-item {
  border-top: 1px solid rgba(148, 163, 184, 0.12);
  padding: 10px 0;
}

.asset-top {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 13px;
  margin-bottom: 4px;
}

.score.ok {
  color: #4ade80;
}

.score.warn {
  color: #fbbf24;
}

.asset-meta {
  display: block;
  font-size: 11px;
  color: #94a3b8;
  margin-bottom: 4px;
}

.asset-note {
  display: block;
  font-size: 12px;
  color: #cbd5e1;
  line-height: 1.5;
}

.ops-item {
  border-top: 1px solid rgba(148, 163, 184, 0.12);
  padding: 10px 0;
}

.ops-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
}

.ops-priority {
  font-size: 11px;
  font-weight: 600;
}

.ops-priority-high {
  color: #f87171;
}

.ops-priority-medium {
  color: #fbbf24;
}

.ops-priority-low,
.ops-priority-info {
  color: #7dd3fc;
}

.ops-source {
  font-size: 10px;
  color: #64748b;
  background: rgba(15, 23, 42, 0.6);
  border-radius: 4px;
  padding: 1px 6px;
}

.ops-title {
  display: block;
  font-size: 13px;
  color: #f1f5f9;
  line-height: 1.55;
  margin-bottom: 4px;
}

.ops-effect {
  display: block;
  font-size: 11px;
  color: #94a3b8;
}
