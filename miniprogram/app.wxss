page {
  background: #0b1220;
  color: #e2e8f0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 14px;
  line-height: 1.5;
}

.block {
  background: rgba(30, 41, 59, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 12px;
  margin-bottom: 14px;
  padding: 14px;
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 12px;
}

.block-head .title {
  font-size: 15px;
  font-weight: 650;
  color: #f1f5f9;
}

.block-tag {
  font-size: 10px;
  color: #7dd3fc;
  background: rgba(56, 189, 248, 0.15);
  border-radius: 999px;
  padding: 2px 8px;
}

.muted {
  color: #94a3b8;
  font-size: 12px;
}

.btn-primary {
  background: #0284c7;
  color: #fff;
  border-radius: 10px;
  font-size: 15px;
}

.btn-primary[disabled] {
  background: #334155;
  color: #94a3b8;
}

.btn-ghost {
  background: rgba(15, 23, 42, 0.5);
  color: #e2e8f0;
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 10px;
}
