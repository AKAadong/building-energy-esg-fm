# 复制为 .env 后按需修改：cp .env.example .env
#
# 一键启动：
#   ./scripts/start-ai-fast.sh     # 最快：先起 docker-chatchat-1 + docker-xinference-1（若存在）
#   ./scripts/one-click-deploy.sh  # 用 docker-compose.ai.yml 起 infra 栈（默认不 build；BUILD=1 才构建）
#
# 若拉镜像报 registry-1.docker.io i/o timeout：
# 1) 配置 Docker daemon 的 registry-mirrors（推荐）
# 2) 或为本机构建指定基础镜像（DaoCloud 等镜像，需自行确认仍可用）：
#    PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.10-bookworm
# model-bootstrap 已与 Xinference 共用同一镜像以减少拉取次数。

# --- 构建 Chatchat 用的 Python 基础镜像（连不上 hub 时请改为镜像站路径）---
PYTHON_BASE_IMAGE=python:3.10-bookworm

# --- 构建 Chatchat 时 pip 依赖下载加速（卡在 pip install 时配置这里）---
# 例（清华）：PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#             PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=

# --- Xinference ---
XINFERENCE_IMAGE=xprobe/xinference:v0.12.3
XINFERENCE_PORT=9997
# 模型下载源：huggingface 或 modelscope（国内常用 modelscope）
XINFERENCE_MODEL_SRC=modelscope

# 自动拉起模型（名称须与 Xinference 界面「Running 模型」里的 ID 一致，不是 39455 那种内部端口）
# LLM 例：qwen2-instruct；Embedding 例：bge-small-zh-v1.5 或 bce-embedding-base_v1（你当前用的就填哪个）
XF_LLM_MODEL_NAME=qwen2-instruct
XF_LLM_SIZE=0.5
XF_LLM_ENGINE=Transformers
XF_LLM_QUANT=none
XF_EMBED_MODEL_NAME=bge-small-zh-v1.5
# 若你在 Xinference 里跑的是 BCE 向量模型，改为：
# XF_EMBED_MODEL_NAME=bce-embedding-base_v1
# 留空表示 CPU；有 GPU 可设为 auto 或 1
XF_N_GPU=

# --- Langchain-Chatchat（默认本地构建 infra-chatchat:local；若改用官方镜像请删除 compose 段或设 CHATCHAT_IMAGE）---
CHATCHAT_IMAGE=infra-chatchat:local
CHATCHAT_API_PORT=7861
CHATCHAT_UI_PORT=8501
# 容器启动时根据 Xinference /v1/models 自动写入 DEFAULT_LLM_MODEL / DEFAULT_EMBEDDING_MODEL（1=开，0=关）
AUTO_SYNC_MODELS=1
# 业务场景演示页（可选）：python3 scripts/serve-building-ai-demo.py ，默认 http://127.0.0.1:8765/

# --- MySQL（可选：docker compose -f docker-compose.ai.yml --profile mysql up -d）---
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=myems
MYSQL_PORT=3306
